 "queries": {
  "attendance_analytics-attendance-detail": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "attendance_analytics-attendance-detail",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT\n\ta.name AS attendance,\n\ta.employee,\n\ta.employee_name,\n\ta.company,\n\ta.status,\n\ta.attendance_date,\n\ta.docstatus,\n\ta.custom_employment_type_location AS location,\n\te.department\nFROM `tabAttendance` a\nLEFT JOIN `tabEmployee` e ON e.name = a.employee\nWHERE a.docstatus < 2\nORDER BY a.attendance_date DESC",
     "type": "sql"
    }
   ],
   "sort_order": 2,
   "title": "Attendance Detail",
   "use_live_connection": 1,
   "workbook": "attendance_analytics"
  },
  "attendance_analytics-company-counts": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "attendance_analytics-company-counts",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT\n\tIFNULL(company, '') AS company,\n\tCOUNT(*) AS attendance_count\nFROM `tabAttendance`\nWHERE docstatus < 2\nGROUP BY company\nORDER BY attendance_count DESC",
     "type": "sql"
    }
   ],
   "sort_order": 1,
   "title": "Company Counts",
   "use_live_connection": 1,
   "workbook": "attendance_analytics"
  },
  "attendance_analytics-status-counts": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "attendance_analytics-status-counts",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT\n\tstatus,\n\tCOUNT(*) AS attendance_count\nFROM `tabAttendance`\nWHERE docstatus < 2\nGROUP BY status\nORDER BY attendance_count DESC",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "Status Counts",
   "use_live_connection": 1,
   "workbook": "attendance_analytics"
  }
 },
